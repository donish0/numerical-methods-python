      "source": [
        "import numpy as np\n",
        "\n",
        "A = np.array([[2,1,1],\n",
        "             [3,2,1],\n",
        "             [2,7,1]], dtype = float)\n",
        "\n",
        "b = np.array([8,13,9])\n",
        "\n",
        "if np.linalg.det(A) == 0:\n",
        "    print(\"singular matrix\")\n",
        "else:\n",
        "    x = np.linalg.solve(A,b)    # np.linalg.inv(A)@b\n",
        "    x = np.round(x,4)\n",
        "    print(x)"
      ]
    }
  ]
}